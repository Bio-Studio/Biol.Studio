// __NAME__ — 类与对象 + 接口。Class 本质是流的分叉，new 宏分叉类流并自动调用 __init__。

program main;

Interface Greeter {
    string greet();
}

Class Hero implements Greeter {
    void __init__(name string, hp int) {
        this::name = name;
        this::hp = hp;
    }

    string greet() { res SIO::format("Hello, I'm %s (hp %d)", this::name, this::hp); }

    string name;
    int hp;
}

Main {
    void exec() {
        Hero h = new Hero("TAK", 88);
        CIO::println(h::greet());

        Greeter g = new Hero("ADA", 100);
        CIO::println(g::greet());
    }
}
